# =========================================================
# CHIPAKK — Production Server Configuration
# =========================================================

RewriteEngine On

# ---------------------------------------------------------
# 1. API & SERVER UPLOADS — PASS THROUGH
# ---------------------------------------------------------
RewriteRule ^api/ - [L]
RewriteRule ^uploads/ - [L]

# ---------------------------------------------------------
# 2. ADMIN STYLESHEET & SCRIPT ISOLATION
# ---------------------------------------------------------

# Admin stylesheet
# /css/admin.css -> /web/css/style.css
RewriteRule ^css/admin\.css$ web/css/style.css [L]

# Admin scripts
# /js/admin.js -> /web/js/admin.js
# /js/api.js -> /web/js/api.js
# /js/firebase-config.js -> /web/js/firebase-config.js
# /js/migration.js -> /web/js/migration.js
RewriteRule ^js/(admin|api|firebase-config|migration)\.js$ web/js/$1.js [L]

# ---------------------------------------------------------
# 3. CUSTOMER STOREFRONT STYLESHEET & SCRIPTS
# ---------------------------------------------------------

# Customer stylesheet
# /css/style.css -> /customer-workspace/css/style.css
RewriteRule ^css/style\.css$ customer-workspace/css/style.css [L]

# Customer scripts
RewriteRule ^js/(app|auth|home|shop|categories|custom-stickers|product|checkout|account|reset-password)\.js$ customer-workspace/js/$1.js [L]

# ---------------------------------------------------------
# 4. CUSTOMER MEDIA ASSETS
# ---------------------------------------------------------

# /assets/* -> /customer-workspace/assets/*
RewriteRule ^assets/(.*)$ customer-workspace/assets/$1 [L]

# ---------------------------------------------------------
# 5. ADMIN PAGE ROUTING
# ---------------------------------------------------------

# /admin
# /admin.html
#        ↓
# /web/admin.html
RewriteRule ^admin/?$ web/admin.html [L]
RewriteRule ^admin\.html$ web/admin.html [L]

# ---------------------------------------------------------
# 6. CUSTOMER PAGE ROUTING
# ---------------------------------------------------------

# /shop
# /shop.html
#        ↓
# /customer-workspace/shop.html
RewriteRule ^shop/?$ customer-workspace/shop.html [L]
RewriteRule ^shop\.html$ customer-workspace/shop.html [L]

# /categories
# /categories.html
RewriteRule ^categories/?$ customer-workspace/categories.html [L]
RewriteRule ^categories\.html$ customer-workspace/categories.html [L]

# /custom-stickers
# /custom-stickers.html
RewriteRule ^custom-stickers/?$ customer-workspace/custom-stickers.html [L]
RewriteRule ^custom-stickers\.html$ customer-workspace/custom-stickers.html [L]

# /product
# /product.html
RewriteRule ^product/?$ customer-workspace/product.html [L]
RewriteRule ^product\.html$ customer-workspace/product.html [L]

# /checkout
# /checkout.html
RewriteRule ^checkout/?$ customer-workspace/checkout.html [L]
RewriteRule ^checkout\.html$ customer-workspace/checkout.html [L]

# /account
# /account.html
RewriteRule ^account/?$ customer-workspace/account.html [L]
RewriteRule ^account\.html$ customer-workspace/account.html [L]

# /reset-password
# /reset-password.html
RewriteRule ^reset-password/?$ customer-workspace/reset-password.html [L]
RewriteRule ^reset-password\.html$ customer-workspace/reset-password.html [L]

# ---------------------------------------------------------
# 7. ROOT CUSTOMER HOMEPAGE
# ---------------------------------------------------------

# /
# /index.html
#        ↓
# /customer-workspace/index.html
RewriteRule ^$ customer-workspace/index.html [L]
RewriteRule ^index\.html$ customer-workspace/index.html [L]

# ---------------------------------------------------------
# 8. CACHE CONTROL POLICIES (Production Freshness Enforcement)
# ---------------------------------------------------------
<IfModule mod_headers.c>
    # 1. HTML Documents: Never cache in browser or intermediate proxies
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # 2. Static CSS, JS: Cache for 7 days (version query string ?v=1.1.0 forces immediate refresh)
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>

    # 3. Static Media Assets (Images, WebP, SVGs, Fonts)
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # 4. API Endpoints: Strictly no-store, no-cache
    <LocationMatch "^/api/">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </LocationMatch>
</IfModule>
