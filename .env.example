# Application Server Config
PORT=3000
NODE_ENV=development

# Hostinger MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=u781826529_chipakk

# CORS Configuration (comma-separated origins for production/dev)
CORS_ORIGIN=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,https://chipakk.shop

# Firebase Admin Credentials (for verifying ID tokens server-side)
FIREBASE_PROJECT_ID=chipakk-77b99
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Uploaded product/category images. REQUIRED in production: the ABSOLUTE path of a directory that is outside the
# deployed app folder, writable by the app user and persistent across deployments (see docs/GST_AND_DEPLOYMENT.md, section 9).
# Set it in the hosting panel's environment variables; never commit a real path or any uploaded file.
# Leave empty only for local development (falls back to server/uploads).
UPLOADS_DIR=

# One-time admin bootstrap. When the `admins` table is completely empty, server/middleware/auth.js normally
# refuses every admin route (403) rather than silently promoting whoever asks. Set this to exactly "true" for
# ONE deliberate request (the very first authenticated Firebase user to call an admin route becomes super_admin),
# then unset it again. Never leave it set to "true" in a running production environment.
ALLOW_ADMIN_BOOTSTRAP=

# Velocity Shipping (THE MARSHANS / Store 2) — server-side only, never exposed to the browser
# Serviceability is blocked (checkout cannot proceed) until all three are set.
VELOCITY_USERNAME=your_velocity_username
VELOCITY_PASSWORD=your_velocity_password
# 6-digit pickup PIN sent as "from" to POST /custom/api/v1/serviceability (production value: 500090)
MARSHANS_PICKUP_PINCODE=
# Optional; defaults to https://shazam.velocity.in
VELOCITY_BASE_URL=https://shazam.velocity.in
